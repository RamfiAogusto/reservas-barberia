# Backend Environment Variables — copiar a .env y completar con valores reales.
# NUNCA subir el archivo .env real al repositorio.

NODE_ENV=development
PORT=5000

# PostgreSQL — usada por Prisma (todas las tablas/migraciones se aplican con
# `npx prisma migrate deploy`, no existe fallback de creación manual de tablas).
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_basedatos

# Variables sueltas de conexión PostgreSQL — solo necesarias para
# backend/scripts/setup-local-db.js al crear la base de datos LOCAL
# (PostgreSQL corriendo en tu máquina, sin Docker). Si usas DATABASE_URL
# con Docker/Render no necesitas estas.
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432

# JWT
JWT_SECRET=usa_una_clave_larga_y_aleatoria_de_al_menos_32_caracteres

# URL pública del frontend — fuente canónica para CORS y enlaces en emails/pagos
FRONTEND_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX
FROM_EMAIL=onboarding@resend.dev

# Pasarela de pago (actualmente simulada/mock — ver services/paymentGatewayService.js)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Redis / BullMQ (recordatorios automáticos — opcional en desarrollo)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloudinary (galería de imágenes — opcional)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
